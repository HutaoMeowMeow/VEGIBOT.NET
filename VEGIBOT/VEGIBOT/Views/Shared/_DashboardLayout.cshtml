<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — VegiBot</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
</head>
<body class="dash-body">

    <aside id="sidebar" class="dash-sidebar" role="navigation" aria-label="Main navigation">

        <div class="sidebar-logo">
            <div class="sidebar-logo-icon">
                <svg width="20" height="20" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M11 2 C8 6 5 9.5 5 13 C5 16.9 7.7 20 11 20 C14.3 20 17 16.9 17 13 C17 9.5 14 6 11 2Z" fill="#A8BFA3" opacity="0.95"/>
                    <path d="M11 6.5 C11 6.5 14.5 10 14.5 13 C14.5 14.9 12.9 16.5 11 16.5 C9.1 16.5 7.5 14.9 7.5 13 C7.5 10 11 6.5 11 6.5Z" fill="#F5F3E9"/>
                    <line x1="11" y1="13" x2="11" y2="19.5" stroke="#5A9E70" stroke-width="1.5" stroke-linecap="round"/>
                    <line x1="11" y1="11.5" x2="13.5" y2="9" stroke="#5A9E70" stroke-width="1.3" stroke-linecap="round"/>
                    <line x1="11" y1="14" x2="8.5" y2="11.5" stroke="#5A9E70" stroke-width="1.3" stroke-linecap="round"/>
                </svg>
            </div>
            <div class="sidebar-logo-text">
                <span class="sidebar-logo-name">VegiBot</span>
                <span class="sidebar-logo-tag">Smart Garden</span>
            </div>
        </div>

        @{
            string active = ViewData["ActiveNav"]?.ToString() ?? "";
            string NavClass(string name) => active == name ? "nav-item active" : "nav-item";
        }

        <p class="sidebar-section-label">Main</p>
        <nav class="sidebar-nav">
            <a href="@Url.Action("Index","Home")" class="@NavClass("Dashboard")">
                <span class="nav-icon"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg></span>
                <span class="nav-label">Dashboard</span>
            </a>
            <a href="@Url.Action("Index","Plants")" class="@NavClass("Plants")">
                <span class="nav-icon"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2C8 6 5 10 5 14a7 7 0 0 0 14 0c0-4-3-8-7-12z"/><line x1="12" y1="14" x2="12" y2="20"/></svg></span>
                <span class="nav-label">My Plants</span>
            </a>
            <a href="@Url.Action("Index","Tasks")" class="@NavClass("Tasks")">
                <span class="nav-icon"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg></span>
                <span class="nav-label">Tasks</span>
            </a>
            <a href="@Url.Action("Index","Reminders")" class="@NavClass("Reminders")">
                <span class="nav-icon"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg></span>
                <span class="nav-label">Reminders</span>
            </a>
            <a href="@Url.Action("Index","Calendar")" class="@NavClass("Calendar")">
                <span class="nav-icon"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg></span>
                <span class="nav-label">Calendar</span>
            </a>
        </nav>

        <p class="sidebar-section-label">Tools</p>
        <nav class="sidebar-nav">
            <a href="@Url.Action("Index","Weather")" class="@NavClass("Weather")">
                <span class="nav-icon"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9z"/></svg></span>
                <span class="nav-label">Weather</span>
            </a>
            <a href="@Url.Action("Index","GardenAI")" class="@NavClass("GardenAI")">
                <span class="nav-icon"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg></span>
                <span class="nav-label">Garden AI</span>
            </a>
            <a href="@Url.Action("Index","PlantHistory")" class="@NavClass("PlantHistory")">
                <span class="nav-icon"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg></span>
                <span class="nav-label">Plant History</span>
            </a>
        </nav>

        <p class="sidebar-section-label">Account</p>
        <nav class="sidebar-nav">
            <a href="@Url.Action("Index","Profile")" class="@NavClass("Profile")">
                <span class="nav-icon"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg></span>
                <span class="nav-label">Profile</span>
            </a>
            <a href="@Url.Action("Index","Settings")" class="@NavClass("Settings")">
                <span class="nav-icon"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg></span>
                <span class="nav-label">Settings</span>
            </a>
            <form asp-action="Logout" asp-controller="Account" method="post" class="nav-logout-form">
                @Html.AntiForgeryToken()
                <button type="submit" class="nav-item nav-logout-btn">
                    <span class="nav-icon"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg></span>
                    <span class="nav-label">Logout</span>
                </button>
            </form>
        </nav>

    </aside>

    <div class="dash-main">
        <header class="dash-header">
            <button id="sidebarToggle" class="sidebar-toggle" aria-label="Toggle navigation" aria-expanded="false">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
            </button>
            <h1 class="header-title">@(ViewData["PageTitle"]?.ToString() ?? ViewData["Title"]?.ToString() ?? "VegiBot")</h1>
            <div class="header-right">
                <div class="header-search">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                    <input type="search" placeholder="Search…" aria-label="Search" />
                </div>
                <a asp-controller="Reminders" asp-action="Index" class="header-icon-btn" aria-label="Reminders" title="Reminders">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
                    <span class="notif-dot" aria-hidden="true"></span>
                </a>
                <a asp-controller="Profile" asp-action="Index" class="header-user" title="Profile">
                    <div class="header-avatar" aria-hidden="true">
                        @{
                            var nameRaw = User.Identity?.Name ?? "G";
                            var initials = nameRaw.Length > 0 ? nameRaw[0].ToString().ToUpperInvariant() : "G";
                        }
                        @initials
                    </div>
                    <span class="header-username">@(nameRaw.Contains('@') ? nameRaw.Split('@')[0] : nameRaw)</span>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
                </a>
            </div>
        </header>
        <div class="dash-content">
            @RenderBody()
        </div>
    </div>

    <div id="sidebarBackdrop" class="sidebar-backdrop" aria-hidden="true"></div>
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
