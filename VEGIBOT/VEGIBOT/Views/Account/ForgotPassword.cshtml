@{
    ViewData["Title"] = "Forgot Password";
    Layout = "_LoginLayout";
}

<div class="login-page">
    <div class="login-panel forgot-panel">
        <div class="login-brand">
            <div class="brand-icon" aria-hidden="true">
                <svg width="36" height="36" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="18" cy="18" r="18" fill="#183D2B" />
                    <path d="M18 8 C14 12 10 16 10 21 C10 25.4 13.6 29 18 29 C22.4 29 26 25.4 26 21 C26 16 22 12 18 8Z" fill="#A8BFA3" opacity="0.7"/>
                    <path d="M18 13 C18 13 22 17 22 21 C22 23.2 20.2 25 18 25 C15.8 25 14 23.2 14 21 C14 17 18 13 18 13Z" fill="#DCE7D8"/>
                    <line x1="18" y1="21" x2="18" y2="29" stroke="#3F7651" stroke-width="1.5" stroke-linecap="round"/>
                    <line x1="18" y1="19" x2="21" y2="16" stroke="#3F7651" stroke-width="1.2" stroke-linecap="round"/>
                    <line x1="18" y1="22" x2="15" y2="19" stroke="#3F7651" stroke-width="1.2" stroke-linecap="round"/>
                </svg>
            </div>
            <span class="brand-name">VegiBot</span>
        </div>

        <div class="forgot-content">
            <h1 class="forgot-title">Password Reset</h1>
            <p class="forgot-message">
                Password recovery via email is not yet available in this version of VegiBot.
                Please contact your administrator to reset your password manually.
            </p>
            <a asp-action="Login" asp-controller="Account" class="btn-back">
                ← Back to Sign In
            </a>
        </div>
    </div>
</div>
