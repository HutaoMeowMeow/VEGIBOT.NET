@model VEGIBOT.Models.DashboardViewModel
@using VEGIBOT.Models

@{
    ViewData["Title"]     = "Dashboard";
    ViewData["PageTitle"] = "Dashboard";
    ViewData["ActiveNav"] = "Dashboard";
    Layout = "_DashboardLayout";
}

@if (Model.IsDemoData)
{
    <div class="demo-banner" role="status">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        <span>Showing <strong>demonstration data</strong> — add your own plants to see real information.</span>
    </div>
}

<!-- Welcome -->
<section class="welcome-section">
    <div class="welcome-text">
        <h2 class="welcome-greeting">@Model.Greeting, @Model.UserName! 👋</h2>
        <p class="welcome-sub">Here's what's happening in your garden today.</p>
    </div>
    <a href="@Url.Action("Create","Plants")" class="btn-add-plant">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Add New Plant
    </a>
</section>

<!-- Stats -->
<section class="stats-grid" aria-label="Garden statistics">
    @{
        var statIcons = new[]
        {
            @"<path d=""M12 2C8 6 5 10 5 14a7 7 0 0 0 14 0c0-4-3-8-7-12z""/><line x1=""12"" y1=""14"" x2=""12"" y2=""20""/>",
            @"<polyline points=""20 6 9 17 4 12""/>",
            @"<polyline points=""9 11 12 14 22 4""/><path d=""M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11""/>",
            @"<path d=""M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9""/><path d=""M13.73 21a2 2 0 0 1-3.46 0""/>"
        };
    }
    @for (var si = 0; si < Model.Stats.Count; si++)
    {
        var stat = Model.Stats[si];
        <div class="stat-card @stat.ColorClass">
            <div class="stat-card-body">
                <div class="stat-icon-wrap">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        @Html.Raw(statIcons[si % statIcons.Length])
                    </svg>
                </div>
                <div class="stat-text">
                    <div class="stat-value">@stat.Value</div>
                    <div class="stat-label">@stat.Label</div>
                </div>
            </div>
            @if (stat.Trend != null)
            {
                <div class="stat-trend">@stat.Trend</div>
            }
        </div>
    }
</section>

<!-- Main grid -->
<div class="dash-grid">
    <div class="dash-col-main">

        <!-- Plant Overview -->
        <section class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2C8 6 5 10 5 14a7 7 0 0 0 14 0c0-4-3-8-7-12z"/></svg>
                    Plant Overview
                </h3>
                <a asp-controller="Plants" asp-action="Index" class="card-link">View All Plants →</a>
            </div>
            <div class="plant-grid">
                @foreach (var plant in Model.Plants)
                {
                    var healthLabel = plant.Health.DisplayName();
                    var healthCss   = plant.Health.HealthCssClass();
                    var stageLabel  = plant.Stage.DisplayName();
                    <div class="plant-card" style="--plant-color: @plant.ColorAccent">
                        <div class="plant-card-top">
                            <div class="plant-emoji" aria-hidden="true">@plant.IconEmoji</div>
                            <div class="plant-info">
                                <div class="plant-name">@plant.Name</div>
                                <div class="plant-variety">@plant.Variety</div>
                            </div>
                            <span class="plant-health @healthCss">@healthLabel</span>
                        </div>
                        <div class="plant-meta">
                            <span>🌱 @stageLabel</span>
                            <span>📅 @plant.PlantedDate.ToString("MMM d")</span>
                        </div>
                        <div class="plant-progress-wrap">
                            <div class="plant-progress-label">
                                <span>Growth</span>
                                <span>@plant.GrowthPercent%</span>
                            </div>
                            <div class="plant-progress-track" role="progressbar"
                                 aria-valuenow="@plant.GrowthPercent" aria-valuemin="0" aria-valuemax="100">
                                <div class="plant-progress-fill" style="width:@plant.GrowthPercent%"></div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </section>

        <!-- Care Tasks -->
        <section class="card" id="tasks-section">
            <div class="card-header">
                <h3 class="card-title">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
                    Upcoming Care Tasks
                </h3>
                <a asp-controller="Tasks" asp-action="Index" class="card-link">View All Tasks →</a>
            </div>
            <ul class="task-list" role="list">
                @foreach (var task in Model.Tasks)
                {
                    var priorityLabel = task.Priority.DisplayName();
                    var priorityCss   = task.Priority.PriorityCssClass();
                    var dueLabel = task.DueDate == DateTime.Today ? "Today"
                                 : task.DueDate == DateTime.Today.AddDays(1) ? "Tomorrow"
                                 : task.DueDate.ToString("MMM d");
                    <li class="task-item @(task.IsCompleted ? "task-done" : "")" data-task-id="@task.Id">
                        <button class="task-check-btn"
                                aria-label="@(task.IsCompleted ? "Mark incomplete" : "Mark complete")"
                                type="button">
                            <svg class="task-check-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                        </button>
                        <div class="task-body">
                            <div class="task-title">@task.Title</div>
                            <div class="task-meta">
                                <span>🌱 @task.PlantName</span>
                                <span>📅 @dueLabel</span>
                            </div>
                        </div>
                        <span class="task-priority @priorityCss">@priorityLabel</span>
                    </li>
                }
            </ul>
        </section>

    </div><!-- /.dash-col-main -->

    <div class="dash-col-side">

        <!-- Weather -->
        <section class="card weather-card">
            <div class="card-header">
                <h3 class="card-title">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9z"/></svg>
                    Weather
                </h3>
                @if (Model.Weather.IsDemoData) { <span class="demo-tag">Demo</span> }
            </div>
            <div class="weather-main">
                <div class="weather-icon">@Model.Weather.ConditionIcon</div>
                <div class="weather-temp">@Model.Weather.TemperatureCelsius°C</div>
            </div>
            <div class="weather-condition">@Model.Weather.Condition</div>
            <div class="weather-stats">
                <div class="weather-stat">
                    <span class="weather-stat-icon">💧</span>
                    <span class="weather-stat-val">@Model.Weather.HumidityPercent%</span>
                    <span class="weather-stat-label">Humidity</span>
                </div>
                <div class="weather-stat">
                    <span class="weather-stat-icon">💨</span>
                    <span class="weather-stat-val">@Model.Weather.WindKph km/h</span>
                    <span class="weather-stat-label">Wind</span>
                </div>
            </div>
            <div class="weather-tip">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                @Model.Weather.GardeningTip
            </div>
        </section>

        <!-- Activity -->
        <section class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
                    Recent Activity
                </h3>
                <a asp-controller="PlantHistory" asp-action="Index" class="card-link">View All →</a>
            </div>
            <ul class="activity-list" role="list">
                @foreach (var item in Model.RecentActivity)
                {
                    <li class="activity-item">
                        <div class="activity-icon-wrap" aria-hidden="true">@item.IconEmoji</div>
                        <div class="activity-body">
                            <div class="activity-desc">@item.Description</div>
                            <div class="activity-time">@RelativeTime(item.Timestamp)</div>
                        </div>
                    </li>
                }
            </ul>
        </section>

        <!-- Insights -->
        <section class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                    Garden Insights
                </h3>
            </div>
            <div class="insight-list">
                @foreach (var tip in Model.Insights)
                {
                    <div class="insight-item">
                        <div class="insight-header">
                            <span class="insight-emoji" aria-hidden="true">@tip.IconEmoji</span>
                            <span class="insight-title">@tip.Title</span>
                            <span class="insight-tag">@tip.TagLabel</span>
                        </div>
                        <p class="insight-body">@tip.Body</p>
                    </div>
                }
            </div>
        </section>

    </div><!-- /.dash-col-side -->
</div><!-- /.dash-grid -->

@functions {
    static string RelativeTime(DateTime dt)
    {
        var diff = DateTime.Now - dt;
        if (diff.TotalMinutes < 2)  return "Just now";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalHours   < 24) return $"{(int)diff.TotalHours}h ago";
        if (diff.TotalDays    < 7)  return $"{(int)diff.TotalDays}d ago";
        return dt.ToString("MMM d");
    }
}
