@model VEGIBOT.Models.TaskListViewModel
@using VEGIBOT.Models

@{
    ViewData["Title"] = "Tasks";
    Layout = "_DashboardLayout";
    var filters = new[] { ("all", "All"), ("pending", "Pending"), ("completed", "Completed"), ("overdue", "Overdue") };
}

<div class="page-header">
    <div>
        <h2>Garden tasks</h2>
        <p>@Model.Tasks.Count task@(Model.Tasks.Count == 1 ? "" : "s") shown</p>
    </div>
    <a class="btn btn-primary" asp-controller="Tasks" asp-action="Create">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Add Task
    </a>
</div>

<div class="toolbar">
    <div class="filter-pills" style="margin-bottom:0;">
        @foreach (var (key, label) in filters)
        {
            <a class="filter-pill @(Model.Filter == key ? "active" : "")"
               asp-controller="Tasks" asp-action="Index"
               asp-route-filter="@key" asp-route-search="@Model.Search">@label</a>
        }
    </div>

    <form method="get" asp-controller="Tasks" asp-action="Index" class="search-box" style="max-width: 320px; margin-left:auto;">
        <input type="hidden" name="filter" value="@Model.Filter" />
        <svg class="icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="search" name="search" value="@Model.Search" placeholder="Search tasks…" aria-label="Search tasks" />
    </form>
</div>

<div class="card">
    @if (Model.Tasks.Count == 0)
    {
        <div class="empty-state">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
            <h3>No tasks here</h3>
            <p class="sub-text">Create a task to plan watering, feeding, pruning and more.</p>
            <div style="margin-top: var(--spacing-md);">
                <a class="btn btn-primary" asp-controller="Tasks" asp-action="Create">Add a task</a>
            </div>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>Task</th>
                        <th>Plant</th>
                        <th>Priority</th>
                        <th>Due</th>
                        <th>Status</th>
                        <th style="text-align:right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var task in Model.Tasks)
                    {
                        var overdue = !task.IsCompleted && task.DueDate.Date < DateTime.Today;
                        <tr>
                            <td>
                                <div style="font-weight:600;">@task.Title</div>
                                <div style="font-size:12px;color:var(--vg-muted);">@task.Category.DisplayName()</div>
                            </td>
                            <td>@(task.Plant?.Name ?? "—")</td>
                            <td><span class="priority-badge @task.Priority.PriorityCssClass()">@task.Priority.DisplayName()</span></td>
                            <td>
                                @task.DueDate.ToString("dd MMM yyyy")
                                @if (overdue)
                                {
                                    <span style="display:block;font-size:11px;color:var(--vg-error);">Overdue</span>
                                }
                            </td>
                            <td>
                                <span class="status-badge @(task.IsCompleted ? "status-badge-completed" : "status-badge-active")">
                                    @(task.IsCompleted ? "Completed" : "Pending")
                                </span>
                            </td>
                            <td>
                                <div class="actions-cell" style="justify-content:flex-end;">
                                    <form asp-controller="Tasks" asp-action="Toggle" asp-route-id="@task.Id" method="post" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn-small">@(task.IsCompleted ? "Undo" : "Complete")</button>
                                    </form>
                                    <a class="btn-small" asp-controller="Tasks" asp-action="Edit" asp-route-id="@task.Id">Edit</a>
                                    <form asp-controller="Tasks" asp-action="Delete" asp-route-id="@task.Id" method="post" onsubmit="return confirm('Delete this task?');" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn-small btn-small-delete">Delete</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
