@model VEGIBOT.Models.PlantFormViewModel

@{
    ViewData["Title"] = "Add Plant";
    Layout = "_DashboardLayout";
}

<div class="page-header">
    <div>
        <h2>Add a plant</h2>
        <p>Record the essentials now — you can refine details later.</p>
    </div>
    <a class="btn btn-secondary" asp-controller="Plants" asp-action="Index">Back to plants</a>
</div>

<div class="card" style="max-width: 820px;">
    <div class="card-body">
        <form asp-controller="Plants" asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <partial name="_PlantForm" model="Model" />
            <div class="form-actions">
                <a class="btn btn-secondary" asp-controller="Plants" asp-action="Index">Cancel</a>
                <button type="submit" class="btn btn-primary">Add Plant</button>
            </div>
        </form>
    </div>
</div>
