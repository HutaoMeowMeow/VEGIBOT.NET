@model VEGIBOT.Models.PlantFormViewModel

@{
    ViewData["Title"] = "Edit Plant";
    Layout = "_DashboardLayout";
}

<div class="page-header">
    <div>
        <h2>Edit @Model.Name</h2>
        <p>Update health, growth stage, and care details.</p>
    </div>
    <a class="btn btn-secondary" asp-controller="Plants" asp-action="Details" asp-route-id="@Model.Id">View plant</a>
</div>

<div class="card" style="max-width: 820px;">
    <div class="card-body">
        <form asp-controller="Plants" asp-action="Edit" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <partial name="_PlantForm" model="Model" />
            <div class="form-actions">
                <a class="btn btn-secondary" asp-controller="Plants" asp-action="Index">Cancel</a>
                <button type="submit" class="btn btn-primary">Save Changes</button>
            </div>
        </form>
    </div>
</div>
