@model VEGIBOT.Models.ProfileViewModel

@{
    ViewData["Title"] = "Profile";
    Layout = "_DashboardLayout";
    var initial = string.IsNullOrWhiteSpace(Model.DisplayName) ? "G" : Model.DisplayName.Trim()[0].ToString().ToUpperInvariant();
}

<div class="page-header">
    <div>
        <h2>Your profile</h2>
        <p>Manage how your account appears across VegiBot.</p>
    </div>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert-success">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert-error">@error</div>
}

<div class="row" style="align-items:flex-start;">
    <div class="col" style="flex: 1 1 300px;">
        <div class="card">
            <div class="card-body" style="text-align:center;">
                <div class="avatar avatar-lg" style="margin: 0 auto 12px;">@initial</div>
                <h3 style="margin:0;font-size:18px;">@Model.DisplayName</h3>
                <p class="text-muted" style="font-size:13px;margin:4px 0 0;">@Model.Email</p>

                <div style="display:flex;gap:10px;margin-top:var(--spacing-lg);">
                    <div style="flex:1;background:var(--vg-ivory);border-radius:var(--radius);padding:12px;">
                        <div style="font-size:20px;font-weight:700;color:var(--vg-forest-green);">@Model.TotalPlants</div>
                        <div style="font-size:11px;text-transform:uppercase;letter-spacing:.6px;color:var(--vg-muted);">Plants</div>
                    </div>
                    <div style="flex:1;background:var(--vg-ivory);border-radius:var(--radius);padding:12px;">
                        <div style="font-size:20px;font-weight:700;color:var(--vg-forest-green);">@Model.TotalTasks</div>
                        <div style="font-size:11px;text-transform:uppercase;letter-spacing:.6px;color:var(--vg-muted);">Tasks</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col" style="flex: 1 1 420px;">
        <div class="card">
            <div class="card-header"><h4>Account name</h4></div>
            <div class="card-body">
                <form asp-controller="Profile" asp-action="UpdateDisplayName" method="post">
                    @Html.AntiForgeryToken()
                    <div class="form-group">
                        <label class="form-label" for="displayName">Name shown in the app</label>
                        <input id="displayName" name="displayName" class="form-input" value="@Model.DisplayName" maxlength="256" pattern="[A-Za-z0-9._-]+" title="Letters, numbers, dots, underscores and dashes only" required />
                        <span class="text-muted" style="font-size:12px;">Letters, numbers, dots, underscores and dashes only.</span>
                    </div>
                    <div class="form-actions" style="margin-top:0;">
                        <button type="submit" class="btn btn-primary">Save Name</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="card">
            <div class="card-header"><h4>Change password</h4></div>
            <div class="card-body">
                <form asp-controller="Profile" asp-action="ChangePassword" method="post">
                    @Html.AntiForgeryToken()
                    <div class="form-group">
                        <label class="form-label" for="CurrentPassword">Current password</label>
                        <input id="CurrentPassword" name="CurrentPassword" type="password" class="form-input" autocomplete="current-password" required />
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="NewPassword">New password</label>
                        <input id="NewPassword" name="NewPassword" type="password" class="form-input" autocomplete="new-password" minlength="6" required />
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="ConfirmPassword">Confirm new password</label>
                        <input id="ConfirmPassword" name="ConfirmPassword" type="password" class="form-input" autocomplete="new-password" minlength="6" required />
                    </div>
                    <div class="form-actions" style="margin-top:0;">
                        <button type="submit" class="btn btn-primary">Update Password</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
