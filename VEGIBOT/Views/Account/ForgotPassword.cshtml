@{
    ViewData["Title"] = "Forgot Password";
    Layout = "_LoginLayout";
}

<div class="login-brand">
    <div class="login-logo" aria-hidden="true">V</div>
    <h2>VegiBot</h2>
    <p>Smart Garden</p>
</div>

<h3>Password reset</h3>
<p class="panel-sub">Let's get you back into your garden.</p>

<div class="alert-error" style="background: var(--vg-ivory); border-color: var(--vg-border); color: var(--vg-dark-text);">
    Password recovery by email is not available in this build. Please ask your
    administrator to reset your password, or register a new account.
</div>

<a class="btn btn-secondary btn-block" asp-controller="Account" asp-action="Login">Back to Sign In</a>

<p class="login-footer">
    Need a new account? <a asp-controller="Account" asp-action="Register">Register</a>
</p>
