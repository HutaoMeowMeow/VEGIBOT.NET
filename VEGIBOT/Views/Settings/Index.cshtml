@model VEGIBOT.Models.SettingsViewModel
@using VEGIBOT.Models

@{
    ViewData["Title"] = "Settings";
    Layout = "_DashboardLayout";
}

<div class="page-header">
    <div>
        <h2>Preferences</h2>
        <p>Control how VegiBot displays information and when it reaches you.</p>
    </div>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert-success">@success</div>
}

<form asp-controller="Settings" asp-action="Save" method="post" style="max-width: 760px;">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="alert-error"></div>

    <div class="card">
        <div class="card-header"><h4>Account</h4></div>
        <div class="card-body">
            <p class="text-muted" style="font-size:13px;margin-top:0;">Change your account name from the <a asp-controller="Profile" asp-action="Index">Profile</a> page.</p>

            <div class="row">
                <div class="col">
                    <div class="form-group">
                        <label asp-for="TemperatureUnit" class="form-label">Temperature unit</label>
                        <select asp-for="TemperatureUnit" class="form-input" asp-items="Html.GetEnumSelectList<TemperatureUnit>()"></select>
                    </div>
                </div>
                <div class="col">
                    <div class="form-group">
                        <label asp-for="DateFormat" class="form-label">Date format</label>
                        <select asp-for="DateFormat" class="form-input" asp-items="Html.GetEnumSelectList<DateDisplayFormat>()"></select>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header"><h4>Notifications</h4></div>
        <div class="card-body" style="display:flex;flex-direction:column;gap:12px;">
            <label class="checkbox-label">
                <input asp-for="NotificationsEnabled" class="checkbox-input" type="checkbox" />
                <span>Enable in-app notifications</span>
            </label>
            <label class="checkbox-label">
                <input asp-for="EmailReminders" class="checkbox-input" type="checkbox" />
                <span>Email me task and reminder alerts</span>
            </label>
            <label class="checkbox-label">
                <input asp-for="WeeklyDigest" class="checkbox-input" type="checkbox" />
                <span>Send a weekly garden digest</span>
            </label>
        </div>
    </div>

    <div class="card">
        <div class="card-header"><h4>Garden</h4></div>
        <div class="card-body">
            <div class="row">
                <div class="col">
                    <div class="form-group">
                        <label asp-for="GardenClimate" class="form-label">Climate</label>
                        <input asp-for="GardenClimate" class="form-input" placeholder="e.g. Temperate" />
                    </div>
                </div>
                <div class="col">
                    <div class="form-group">
                        <label asp-for="GardenLocation" class="form-label">Location</label>
                        <input asp-for="GardenLocation" class="form-input" placeholder="e.g. Back garden, north bed" />
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="form-actions" style="justify-content:flex-start;">
        <button type="submit" class="btn btn-primary">Save Settings</button>
    </div>
</form>
