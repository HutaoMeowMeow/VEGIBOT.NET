@model VEGIBOT.Models.ReminderFormViewModel

@{
    ViewData["Title"] = "Edit Reminder";
    Layout = "_DashboardLayout";
}

<div class="page-header">
    <div>
        <h2>Edit reminder</h2>
        <p>Update the schedule or the plants it applies to.</p>
    </div>
    <a class="btn btn-secondary" asp-controller="Reminders" asp-action="Index">Back to reminders</a>
</div>

<div class="card" style="max-width: 760px;">
    <div class="card-body">
        <form asp-controller="Reminders" asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="IsCompleted" />
            <partial name="_ReminderForm" model="Model" />
            <div class="form-actions">
                <a class="btn btn-secondary" asp-controller="Reminders" asp-action="Index">Cancel</a>
                <button type="submit" class="btn btn-primary">Save Changes</button>
            </div>
        </form>
    </div>
</div>
