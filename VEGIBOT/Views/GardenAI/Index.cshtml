@model VEGIBOT.Models.AiChatViewModel

@{
    ViewData["Title"] = "Garden AI";
    Layout = "_DashboardLayout";
}

@if (!Model.IsConfigured)
{
    <div class="demo-banner">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
        <span>@(Model.ConfigurationNote ?? "Garden AI is not configured yet. Add an API key in appsettings.json to enable personalised answers.")</span>
    </div>
}

<div class="card" style="max-width: 820px;">
    <div class="card-header">
        <h4>Conversation</h4>
        <span class="text-muted" style="font-size:12px;">@Model.Messages.Count message@(Model.Messages.Count == 1 ? "" : "s")</span>
    </div>

    <div class="card-body" style="max-height: 460px; overflow-y: auto;">
        @if (Model.Messages.Count == 0)
        {
            <div class="empty-state">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                <h3>No messages yet</h3>
                <p class="sub-text">Ask your first gardening question below.</p>
            </div>
        }
        else
        {
            <div style="display:flex;flex-direction:column;gap:12px;">
                @foreach (var msg in Model.Messages)
                {
                    var isUser = string.Equals(msg.Role, "user", StringComparison.OrdinalIgnoreCase);
                    <div style="display:flex;gap:10px;@(isUser ? "flex-direction:row-reverse;" : "")">
                        <div class="avatar avatar-sm" style="background:@(isUser ? "var(--vg-light-sage)" : "var(--vg-forest-green)");color:@(isUser ? "var(--vg-forest-green)" : "#fff");">
                            @(isUser ? "You" : "AI")
                        </div>
                        <div style="max-width:78%;background:@(isUser ? "var(--vg-ivory)" : "#F7F8F4");border:1px solid var(--vg-border-light);border-radius:10px;padding:10px 12px;font-size:13.5px;">
                            @msg.Content
                            <div class="text-muted" style="font-size:11px;margin-top:4px;">@msg.Timestamp.ToString("dd MMM, HH:mm")</div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <div class="card-footer">
        <form asp-controller="GardenAI" asp-action="Chat" method="post" style="display:flex;gap:8px;align-items:flex-end;">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Role" value="user" />
            <div style="flex:1;">
                <label class="form-label" for="chatContent">Your question</label>
                <textarea id="chatContent" name="Content" class="form-input" rows="2" placeholder="e.g. How often should I water cherry tomatoes in summer?" required></textarea>
            </div>
            <button type="submit" class="btn btn-primary" style="margin-bottom:2px;">Send</button>
        </form>
    </div>
</div>
